<?xml version="1.0" encoding="utf-8"?>
<!--
  生产姿态：禁止明文 HTTP。

  调试包会用到 app/src/debug/res/xml/network_security_config.xml 覆盖本文件
  （Android 资源合并规则：debug 变体优先），那里对局域网地址放行了明文，
  方便真机连本机后端联调。发布包不受影响。
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
