# 复制成 deploy/.env 后按需修改；.env 不入库。
#
# 站点地址：
#   生产   SITE_ADDRESS=coin.example.com
#          Caddy 会自动向 Let's Encrypt 申请证书（要求域名已解析到本机、
#          80/443 可被公网访问；国内主机还需先完成 ICP 备案）。
#   过渡   SITE_ADDRESS=:8443
#          只有 IP、还没备案时用非标端口跑 HTTP。
#   本地   SITE_ADDRESS=:8080
SITE_ADDRESS=:8080

# 每个 IP 每秒的请求数上限（公开站点防刷）
COIN_RATE_LIMIT=20

# 额外放行的跨域来源，逗号分隔。留空即可 ——
# 安卓 APK 需要的 https://localhost 与 capacitor://localhost 已在代码默认值里。
COIN_ALLOWED_ORIGINS=
