*.local
.DS_Store

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
pytest-cache-files-*/
.mypy_cache/

# 中间产物（可由脚本重建，不入库）；成品数据库与图片库入库，克隆即可运行
services/api/content/generated/
services/api/content/review/
services/api/content/*.db-wal
services/api/content/*.db-shm
.tmp/

# 原始素材（docx/zip，体积过大且 zip 超 GitHub 100MB 单文件上限，本地保存）
docs/*.zip
docs/钱币简介/
docs/钱币简介-29册/

# 安卓工具链与构建产物（机器相关，可重建）
.toolchain/
# 注意：apps/web/android 是 Capacitor 生成的工程，**需要入库**
# （图标、清单、签名配置等定制都在里面），它自带的 .gitignore 会排除 build/ 等产物。
# 签名密钥：绝对不要入库
*.keystore
*.jks
keystore.properties

# 编辑器
.vscode/
.idea/
